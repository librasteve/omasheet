// Every column type, with dates and times: a whole number beside a Date
// counts days, and beside a Time or a Datetime seconds, and two of a kind
// differ by a Duration, shown in the unit its column names, or as `PT8H30M`
// under `Duration[iso]`. A file always writes dates and times the ISO way,
// and may say which time zone its date-times are in. The hourly rate is money,
// `Currency` in pounds, and the hours times it is money too.

zone Europe/London
const Day = P1D

sheet Shifts

Who    : String
On     : Date
Start  : Time
End    : Time
Rate   : Currency[GBP; $.2f]
Pay    : Currency[GBP; $.2f]
Paid   : Boolean
Logged : Datetime
Shift  : Duration[iso]
Delay  : Duration[%H:%M:%S]

| Who   | On         | Start | End   | Rate  | Paid  | Logged              | Begins | Shift | Hours | Pay | Due | Weekday | Month | Delay | Late | Sydney |
| ----- | ---------- | ----- | ----- | ----- | ----- | ------------------- | ------ | ----- | ----- | --- | --- | ------- | ----- | ----- | ---- | ------ |
| Ada   | 2025-01-31 | 09:00 | 17:30 | 21.50 | true  | 2025-01-31T17:42    | *      | *     | *     | *   | *   | *       | *     | *     | *    | *      |
| Grace | 2025-02-01 | 22:00 | 06:00 | 24    | false | 2025-02-03T08:05:30 | *      | *     | *     | *   | *   | *       | *     | *     | *    | *      |
| Linus | 2025-02-28 | 13:15 | 18:00 | 19.75 | true  | 2025-02-28T18:00    | *      | *     | *     | *   | *   | *       | *     | *     | *    | *      |

Begins  := On + Start
Shift   := if End > Start then End - Start else End - Start + Day
Hours   := Shift.total_hours()
Pay     := Hours * Rate
Due     := On + 30
Weekday := On.weekday()
Month   := On.month()
Delay   := Logged - Begins
Late    := Logged.date() > On
Sydney  := Logged.convert_time_zone('Australia/Sydney')

sheet Totals

Span : Duration[d]
Pay  : Currency[GBP; $.2f]

| Label | Hours | Pay | First | Span |
| ----- | ----- | --- | ----- | ---- |
| All   | *     | *   | *     | *    |

Hours := Shifts.Hours.sum()
Pay   := Shifts.Pay.sum()
First := Shifts.On.min()
Span  := Shifts.On.max() - Shifts.On.min()

// A column of dates or times shown by a C `strftime` format after its type in
// brackets, with `%f` for a fraction of a second, glibc's flags, `%-d`, and
// `%]` for a `]`. The value is unchanged; only how it is shown. Names of days
// and months are the locale's, which this example prints in the `C` locale, so
// in English.
sheet Diary

Day    : Date[%a %-d %b %Y]
Week   : Date[%G-W%V-%u]
Starts : Time[%-I:%M %p]
Lap    : Time[%M:%S.%3f]
At     : Datetime[%d/%m/%Y %H:%M %Z]
Stamp  : Datetime[[%F %T %z%]]

| Event   | Day        | Week       | Starts | Lap          | At               | Stamp               |
| ------- | ---------- | ---------- | ------ | ------------ | ---------------- | ------------------- |
| Launch  | 2025-01-31 | 2025-01-31 | 09:30  | 00:01:02.5   | 2025-01-31T09:30 | 2025-01-31T09:30:15 |
| Review  | 2024-12-30 | 2024-12-30 | 17:05  | 00:59:59.999 | 2025-07-01T12:00 | 2025-07-01T12:00    |
| Wrap-up | 2027-01-03 | 2027-01-03 | 00:15  | 00:00:00     | 2026-10-25T01:30 | 2026-10-25T01:30    |
