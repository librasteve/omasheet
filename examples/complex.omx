# Complex numbers: a real and an imaginary part, each a Float. `3+4i` is the
# sum of `3` and `4i`, and a Complex is above Float in the type lattice, so a
# real number beside one makes the result a Complex.
#
# A Complex has no order, so there is no `<`, `max` or sort; `=` and `!=` take
# both parts, exactly. To get a real number out, use `re` or `abs`, or `.Float`
# where the imaginary part is exactly zero; `=~=` is the comparison that
# allows for the noise of a calculation.
# In a Parquet file a Complex column is a struct of two doubles, `re` and `im`.
#
# The maths functions are here too. A real argument past the edge of a
# function's real domain gives the principal complex value, not NaN, and the
# edge itself stays real; a column that holds one is Complex, where a column
# declared Float would reject the cell, and `sqrt(-4).Float` is an error.
# `round floor ceil radians degrees` do not take a complex number.
#
# Each function is set beside its inverse, and the inverse of the result is
# set beside the argument, so a round trip reads across a row. A Match is
# true where every trip comes back to within 1e-12: a function and its
# inverse meet only on the principal branch, so the arguments are chosen
# inside it.
# The trips are rounded to 12 places before they are shown, because the last
# digit of a trip is the maths library's to say: it differs between machines,
# and the display marks a number whose noise it rounds away.

sheet Parts

Z : Complex

| Z       | Re | Im | Abs | Angle | Conj | Root | Exp | Ln |
| ------- | -- | -- | --- | ----- | ---- | ---- | --- | -- |
| 3+4i    | *  | *  | *   | *     | *    | *    | *   | *  |
| -4      | *  | *  | *   | *     | *    | *    | *   | *  |
| 2i      | *  | *  | *   | *     | *    | *    | *   | *  |
| -1.5-2i | *  | *  | *   | *     | *    | *    | *   | *  |

Re    := re(Z)
Im    := im(Z)
Abs   := abs(Z)
Angle := arg(Z)
Conj  := conj(Z)
Root  := sqrt(Z)
Exp   := exp(Z)
Ln    := ln(Z)

# The four operations, and a power: a whole exponent is repeated
# multiplication, as in Raku, and any other is exp(w ln z).
sheet Arithmetic

A : Complex
B : Complex

| A    | B    | Sum | Difference | Product | Quotient | Squared | Doubled | Same |
| ---- | ---- | --- | ---------- | ------- | -------- | ------- | ------- | ---- |
| 1+2i | 3-1i | *   | *          | *       | *        | *       | *       | *    |
| 2i   | 2i   | *   | *          | *       | *        | *       | *       | *    |
| 1+1i | 1-1i | *   | *          | *       | *        | *       | *       | *    |

Sum        := A + B
Difference := A - B
Product    := A * B
Quotient   := A / B
Squared    := A ** 2
Doubled       := A * 2
Same       := A == A

# A real number in a Complex column has no imaginary part, and a Complex is
# a real number only where its imaginary part is zero.
sheet Reals

Z : Complex

| Z    | IsReal  | AsFloat | AsInteger |
| ---- | ------- | ------- | --------- |
| 5    | *       | *       | *         |
| 3+0i | *       | *       | *         |
| 2.5  | *       | *       | *         |

IsReal    := im(Z) == 0
AsFloat   := Z.Float
AsInteger := re(Z).Integer

sheet Beyond

| X    | Sqrt | Ln | Log10 | Arcsin | Arccos | Arccosh | Arctanh | Power |
| ---- | ---- | -- | ----- | ------ | ------ | ------- | ------- | ----- |
| -4   | *    | *  | *     | *      | *      | *       | *       | *     |
| -1   | *    | *  | *     | *      | *      | *       | *       | *     |
| 0    | *    | *  | *     | *      | *      | *       | *       | *     |
| 0.5  | *    | *  | *     | *      | *      | *       | *       | *     |
| 1    | *    | *  | *     | *      | *      | *       | *       | *     |
| 2    | *    | *  | *     | *      | *      | *       | *       | *     |

Sqrt    := sqrt(X)
Ln      := ln(X)
Log10   := log10(X)
Arcsin  := arcsin(X)
Arccos  := arccos(X)
Arccosh := arccosh(X)
Arctanh := arctanh(X)
Power   := X ** 0.5

# exp and ln, and a root and its square. The imaginary part of the argument
# is within (-pi, pi], which is where ln undoes exp.
sheet LogExp

Z : Complex

| Z     | Exp | LnExp | Ln | ExpLn | Root | Squared | Match |
| ----- | --- | ----- | -- | ----- | ---- | ------- | ----- |
| 1+2i  | *   | *     | *  | *     | *    | *       | *     |
| -1-2i | *   | *     | *  | *     | *    | *       | *     |
| 0.5+3i | *  | *     | *  | *     | *    | *       | *     |
| 2-1.5i | *  | *     | *  | *     | *    | *       | *     |

Exp     := exp(Z)
LnExp   := round(re(ln(Exp)), 12) + round(im(ln(Exp)), 12) * 1i
Ln      := ln(Z)
ExpLn   := round(re(exp(Ln)), 12) + round(im(exp(Ln)), 12) * 1i
Root    := sqrt(Z)
Squared := round(re(Root ** 2), 12) + round(im(Root ** 2), 12) * 1i
Match   := abs(LnExp - Z) < 1e-12 and abs(ExpLn - Z) < 1e-12 and abs(Squared - Z) < 1e-12

# sin, cos and tan against arcsin, arccos and arctan. The real part of the
# argument is within (0, pi/2), where all three come back.
sheet Trig

Z : Complex

| Z        | Sin | ArcSin | Cos | ArcCos | Tan | ArcTan | Match |
| -------- | --- | ------ | --- | ------ | --- | ------ | ----- |
| 1+2i     | *   | *      | *   | *      | *   | *      | *     |
| 0.5+0.5i | *   | *      | *   | *      | *   | *      | *     |
| 1.2-0.7i | *   | *      | *   | *      | *   | *      | *     |
| 0.3+1i   | *   | *      | *   | *      | *   | *      | *     |

Sin    := sin(Z)
ArcSin := round(re(arcsin(Sin)), 12) + round(im(arcsin(Sin)), 12) * 1i
Cos    := cos(Z)
ArcCos := round(re(arccos(Cos)), 12) + round(im(arccos(Cos)), 12) * 1i
Tan    := tan(Z)
ArcTan := round(re(arctan(Tan)), 12) + round(im(arctan(Tan)), 12) * 1i
Match  := abs(ArcSin - Z) < 1e-12 and abs(ArcCos - Z) < 1e-12 and abs(ArcTan - Z) < 1e-12

# sinh, cosh and tanh against arcsinh, arccosh and arctanh. The real part is
# positive and the imaginary part within [0, pi/2), where all three come back.
sheet Hyper

Z : Complex

| Z        | Sinh | ArcSinh | Cosh | ArcCosh | Tanh | ArcTanh | Match |
| -------- | ---- | ------- | ---- | ------- | ---- | ------- | ----- |
| 1+1i     | *    | *       | *    | *       | *    | *       | *     |
| 0.5+0.5i | *    | *       | *    | *       | *    | *       | *     |
| 1.2+0.7i | *    | *       | *    | *       | *    | *       | *     |
| 0.3+1i   | *    | *       | *    | *       | *    | *       | *     |

Sinh    := sinh(Z)
ArcSinh := round(re(arcsinh(Sinh)), 12) + round(im(arcsinh(Sinh)), 12) * 1i
Cosh    := cosh(Z)
ArcCosh := round(re(arccosh(Cosh)), 12) + round(im(arccosh(Cosh)), 12) * 1i
Tanh    := tanh(Z)
ArcTanh := round(re(arctanh(Tanh)), 12) + round(im(arctanh(Tanh)), 12) * 1i
Match   := abs(ArcSinh - Z) < 1e-12 and abs(ArcCosh - Z) < 1e-12 and abs(ArcTanh - Z) < 1e-12
