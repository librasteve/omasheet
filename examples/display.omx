# How each kind of number is shown: the display table of the numerics spec,
# one sheet for each type.
#
# A number is shown in at most 23 characters. From 1e-15 up to 1e15 it is
# plain; smaller or larger, or too wide to be plain, it is in e notation, with
# its mantissa cut and marked · where even that is too wide. The Spec column
# is how the spec shows the value in the app, in a locale that writes
# 12,345.5, to compare with how it is shown there; `print` does not group
# digits. A Float is first rounded to 15 places after its point, the noise
# of a calculation shown as nought, so 5e-324 is shown 0 where the Spec
# column, which is the table as first written, has it in e notation.

sheet Ints

Value : Integer
Spec  : String

| Size   | Value              | Spec                      |
| ------ | ------------------ | ------------------------- |
| Small  | 0                  | "0"                       |
| Small  | 7                  | "7"                       |
| Small  | 999999999999999    | "999999999999999"         |
| Medium | = 10**15           | "1e+15"                   |
| Medium | 123456789012345678 | "1.23456789012345678e+17" |
| Medium | = 10**18 - 1       | "9.99999999999999999e+17" |

sheet Decimals

Value : Decimal
Spec  : String

| Size   | Value                                         | Spec                      |
| ------ | --------------------------------------------- | ------------------------- |
| Small  | 0.00000000000000000000000000000000000001       | "1e-38"                   |
| Small  | 0.00000000000000012345678901234567890         | "1.2345678901234567·e-16" |
| Small  | 0.00000000000000099                           | "9.9e-16"                 |
| Medium | 0.000000000000001                             | "0.000000000000001"       |
| Medium | 0.0000000000000012345678                      | "1.2345678e-15"           |
| Medium | 0.125                                         | "0.125"                   |
| Medium | 19.99                                         | "19.99"                   |
| Medium | 200000                                        | "200,000"                 |
| Medium | 0.12345678901234567890123                     | "0.123·"                  |
| Medium | 999999999999999.9999999                       | "999999999999999.9999999" |
| Large  | 1000000000000000                              | "1e+15"                   |
| Large  | = 2**64                                       | "1.8446744073709551·e+19" |
| Large  | = 10**37                                      | "1e+37"                   |
| Large  | 1234567890123456.5                            | "1.2345678901234565e+15"  |
| Large  | 123456789012345678.5                          | "1.2345678901234567·e+17" |

# A Fraction is shown as a fraction of whole numbers where there is one of a
# denominator up to 10000, and as a decimal where there is not.
sheet Fractions

Value : Fraction
Spec  : String

| Size   | Value              | Spec                      |
| ------ | ------------------ | ------------------------- |
| Small  | = 1 / (7 * 10**20) | "1.42857142857142857e-21" |
| Small  | = 1 / 10001        | "0.00009999000099990000·" |
| Small  | = 1 / 10000        | "1/10000"                 |
| Medium | 1/3                | "1/3"                     |
| Medium | 22/7               | "3 1/7"                   |
| Medium | = 1000 / 3         | "333 1/3"                 |
| Medium | 0.125              | "1/8"                     |
| Medium | 2 3/4              | "2 3/4"                   |
| Medium | = 1/3 + 1/7 + 1/11 | "131/231"                 |

sheet Percents

Value : Percent
Spec  : String

| Size   | Value               | Spec                  |
| ------ | ------------------- | --------------------- |
| Small  | 0.000001%           | "0%"                  |
| Small  | 0.004%              | "0%"                  |
| Medium | 0.005%              | "0.01%"               |
| Medium | 12.5%               | "12.5%"               |
| Medium | 20%                 | "20%"                 |
| Medium | = 5 / 12            | "41.67%"              |
| Medium | 999999999999999.99% | "999999999999999.99%" |
| Large  | = 10**13            | "1e+15%"              |
| Large  | = 10**18 / 7        | "1.43e+19%"           |

sheet Nums

Value : Float
Spec  : String

| Size   | Value                   | Spec                      |
| ------ | ----------------------- | ------------------------- |
| Small  | 5e-324                  | "5e-324"                  |
| Small  | 9.999999999999999e-16   | "1.000·e-15"             |
| Medium | 1e-15                   | "0.000000000000001"       |
| Medium | 1.2345678e-15           | "1.235·e-15"              |
| Medium | = (1/3).Float             | "0.333·"                 |
| Medium | = 0.1.Float + 0.2.Float     | "0.300·"                 |
| Medium | = 999999999999999.9.Float | "999999999999999.9"       |
| Large  | 1e15                    | "1e+15"                   |
| Large  | 1.7976931348623157e308  | "1.798·e+308"           |

sheet Complexes

Value : Complex
Spec  : String

| Size   | Value                                   | Spec                     |
| ------ | --------------------------------------- | ------------------------ |
| Small  | = 1e-20 + 2e-20 * 1i                    | "1e-20+2e-20i"           |
| Small  | = 5e-324 + 5e-324 * 1i                  | "5e-324+5e-324i"         |
| Medium | 1i                                      | "0+1i"                   |
| Medium | 3+4i                                    | "3+4i"                   |
| Medium | 0.5+0.25i                               | "0.5+0.25i"              |
| Medium | = (1/3).Float + 1i                      | "0.333+1i·"            |
| Medium | = (1/3).Float + (1/3).Float * 1i        | "0.333+0.333i·"       |
| Medium | =300000+300000i                         | "300,000+300,000i"       |
| Large  | = 1e20 + 0i                             | "1e+20+0i"               |
| Large  | = 1.2345678901234567e20 * (1 + 1i)      | "1.235e+20+1.235e+20i·" |
| Large  | = 1.7976931348623157e308 * (1 + 1i)     | "1.79e+308+1.79e+308i·" |
