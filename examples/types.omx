# The numbers, Bool and Text: what each type holds and how it is shown.
#
# Int, Decimal, Fraction and Percent are exact and a Num is floating
# point. Decimal, Fraction and Percent hold the same numbers and show them
# in different ways: as a decimal, as a fraction, and as so many in a
# hundred.
#
# A number is shown in at most 23 characters: plain from 1e-15 to 1e15, and
# in e notation otherwise, with digits that do not fit cut and marked with
# …. A Decimal that does not end is cut and marked too, and a Fraction is a
# fraction where it fits. A number worked out from Ints and Decimals is a
# Decimal; a column of no declared type with one that does not end is a
# Fraction column. A Percent is rounded to two digits, and a Num is never
# rounded; all are held in full.
# `omasheet --exact examples/types.omx` shows them in full.

const Half = 50%
const Third = 1/3
const Root2 = sqrt(2)

sheet Numbers

Name    : Text
Count   : Int
Price   : Decimal
Share   : Fraction
Rate    : Percent
Reading : Num
Checked : Bool

| Name  | Count                      | Price | Share | Rate  | Reading  | Checked |
| ----- | -------------------------- | ----- | ----- | ----- | -------- | ------- |
| seven | 7                          | 19.99 | 1/7   | 20%   | 1.5      | true    |
| cent  | 100                        | 0.125 | 2/3   | 12.5% | 100      | false   |
| minus | -3                         | -4.5  | 5/2   | -5%   | -1.6e-19 | true    |
| huge  | 10_000_000_000_000_000_000 | 1000  | 3     | 0.5   | 6.02e23  | false   |

# What is done with the numbers above. A column with no type takes the type
# of its formula.
sheet Arithmetic

| Name  | Square | Inverse | Whole | Taxed | Split | Raised | Part | Scaled | Root | Likely |
| ----- | ------ | ------- | ----- | ----- | ----- | ------ | ---- | ------ | ---- | ------ |
| seven | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| cent  | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| minus | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| huge  | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |

# Exact stays exact: an Int does not overflow, and a division is held in
# full.
Square  := Numbers[Count; *] ** 2
Inverse := 1 / Numbers[Count; *]
Whole   := Inverse * Numbers[Count; *]

# Sums, products and divisions of Decimals are Decimal, though a division
# need not end.
Taxed   := Numbers[Price; *] * 1.2
Split   := Numbers[Price; *] / 3

# Percents add up to a Percent. Anything else done with one gives the plain
# number, so a price times a rate is a price.
Raised  := Numbers[Rate; *] + 5%
Part    := Numbers[Price; *] * Numbers[Rate; *]

# One Num makes the result a Num.
Scaled  := Numbers[Share; *] * Numbers[Reading; *]
Root    := sqrt(Numbers[Reading; *].abs())

Likely  := Numbers[Checked; *] and Numbers[Share; *] < Half

# No exact number is a division by zero, so that is a Num: Inf, -Inf, or NaN
# for zero over zero. So is a function outside its domain. Each is written
# in a cell as it is shown, and the text of one is in quotes. A NaN is not
# equal to anything, itself included.
sheet Limits

| Top | Over | Root | Log | Limit | Same | Word   | Add           | Multiply      |
| --- | ---- | ---- | --- | ----- | ---- | ------ | ------------- | ------------- |
| 1   | *    | *    | *   | Inf   | *    | "Inf"  | =Inf+[*-6; *] | =Inf*[*-7; *] |
| -1  | *    | *    | *   | -Inf  | *    | "-Inf" | =Inf+[*-6; *] | =Inf/[*-7; *] |
| 0   | *    | *    | *   | NaN   | *    | "NaN"  | =Inf+[*-6; *] | =Inf*[*-7; *] |

Over := Top / 0
Root := sqrt(Top)
Log  := ln(Top)
Same := Limit == Limit

# The name of a type converts to it: `x.Int`, `x.Int()` or `Int(x)`.
sheet Converted

| Value  | AsInt | Rounded | AsDecimal | AsPercent | AsNum | AsBool | AsText | Back |
| ------ | ----- | ------- | --------- | --------- | ----- | ------ | ------ | ---- |
| 19.99  | *     | *       | *         | *         | *     | *      | *      | *    |
| -19.99 | *     | *       | *         | *         | *     | *      | *      | *    |
| 1/3    | *     | *       | *         | *         | *     | *      | *      | *    |
| 1/8    | *     | *       | *         | *         | *     | *      | *      | *    |
| 0.5    | *     | *       | *         | *         | *     | *      | *      | *    |
| 0      | *     | *       | *         | *         | *     | *      | *      | *    |

AsInt     := Value.Int
Rounded   := round(Value)

# `.Decimal` takes any Fraction: `(1/3).Decimal` is shown cut and marked.
# A Num always has a Decimal: the one it is shown as.
AsDecimal := Value.Num.Decimal
AsPercent := Value.Percent
AsNum     := Value.Num
AsBool    := Value.Bool
AsText    := Value.Text
Back      := Value.Num.Fraction == Value

# A Fraction is shown as a fraction, and one of more than one as a whole
# number and a part. It may be written either way: `2 3/4` is `11/4`. In a
# Fraction column a decimal is a fraction too, and anything worked out from
# a fraction is one.
sheet Mixes

Yield : Fraction

| Name   | Yield | Doubled | Share |
| ------ | ----- | ------- | ----- |
| mortar | 7/3   | *       | *     |
| screed | 22/7  | *       | *     |
| lean   | 2 3/4 | *       | *     |
| wide   | 0.5   | *       | *     |

Doubled := Yield * 2
Share   := Yield.Percent

# Text is read the way a cell is.
sheet Written

Text : Text

| Text  | Number | Doubled | Whole | Decimal | Percent |
| ----- | ------ | ------- | ----- | ------- | ------- |
| 42    | *      | *       | *     | *       | *       |
| 20%   | *      | *       | *     | *       | *       |
| 1/8   | *      | *       | *     | *       | *       |
| 1.5e3 | *      | *       | *     | *       | *       |

Number  := Text.Fraction
Doubled := Number * 2
Whole   := Text.Int
Decimal := Text.Decimal
Percent := Text.Percent
