# The numbers, Bool and Text: what each type holds and how it is shown.
#
# Int and Ratio are exact, a Num is floating point, and a Complex is a pair
# of Nums. A number is shown with up to five digits after the point; one
# with more is rounded and marked with …, and is still held in full.
# `omasheet --exact examples/types.omx` shows every number in full.

const Half = 50%
const Third = 1/3
const Root2 = sqrt(2)
const Turn = 1i

table Numbers

Name    : Text
Count   : Int
Share   : Ratio
Reading : Num
Wave    : Complex
Checked : Bool

Name  | Count                      | Share | Reading | Wave    | Checked | Square | Inverse | Whole | Scaled | Root | Size | Turned | Likely
seven | 7                          | 1/7   | 1.5     | 3+4i    | true    | *      | *       | *     | *      | *    | *    | *      | *
cent  | 100                        | 20%   | 100     | 2i      | false   | *      | *       | *     | *      | *    | *    | *      | *
minus | -3                         | 19.99 | 1.6e-19 | -1.5-2i | true    | *      | *       | *     | *      | *    | *    | *      | *
huge  | 10_000_000_000_000_000_000 | 0.125 | 6.02e23 | 1       | false   | *      | *       | *     | *      | *    | *    | *      | *

# Exact stays exact: an Int does not overflow, and a division is a Ratio.
Square  := Count ** 2
Inverse := 1 / Count
Whole   := Inverse * Count

# One Num makes the result a Num.
Scaled  := Share * Reading
Root    := sqrt(Reading)

# A Complex shows each part as a Num.
Size    := abs(Wave)
Turned  := Wave * Turn

Likely  := Checked and Share < Half

# The name of a type converts to it: `x.Int`, `x.Int()` or `Int(x)`.
table Converted

Value : Ratio

Value  | AsInt | Rounded | AsNum | AsComplex | AsBool | AsText | Back
19.99  | *     | *       | *     | *         | *      | *      | *
-19.99 | *     | *       | *     | *         | *      | *      | *
1/3    | *     | *       | *     | *         | *      | *      | *
0.5    | *     | *       | *     | *         | *      | *      | *
0      | *     | *       | *     | *         | *      | *      | *

AsInt     := Value.Int
Rounded   := round(Value)
AsNum     := Value.Num
AsComplex := Value.Complex
AsBool    := Value.Bool
AsText    := Value.Text
Back      := Value.Num.Ratio == Value

# Text is read the way a cell is.
table Written

Text : Text

Text  | Number | Doubled | Whole
42    | *      | *       | *
20%   | *      | *       | *
1/8   | *      | *       | *
1.5e3 | *      | *       | *

Number  := Text.Ratio
Doubled := Number * 2
Whole   := Text.Int
