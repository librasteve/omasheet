# The numbers, Boolean and the kinds of text: what each type holds and how
# it is shown.
#
# Integer, Decimal, Fraction and Percent are exact and a Float is floating
# point. Decimal, Fraction and Percent hold the same numbers and show them
# in different ways: as a decimal, as a fraction, and as so many in a
# hundred.
#
# A number is shown in at most 23 characters: plain from 1e-15 to 1e15, and
# in e notation otherwise, with digits that do not fit cut and marked with
# …. A Decimal that does not end is cut and marked too, and a Fraction is a
# fraction where there is one of a small enough denominator. A number worked
# out from Ints and Decimals is a Decimal; a Fraction column is declared. A
# Percent is rounded to two digits, and a Float is never rounded.
#
# Thirty of the thirty-eight digits an exact number holds are shown; the
# last eight are working room, so that two ways of reaching one number
# agree. 1/3 * 3 is 1, and 2/7 + 3/7 == 5/7.
# `omasheet --exact examples/types.omx` shows them in full.

const Half = 50%
const Third = 1/3
const Root2 = sqrt(2)

sheet Numbers

Name    : String
Count   : Integer
Price   : Decimal
Share   : Fraction
Rate    : Percent
Reading : Float
Checked : Boolean

| Name  | Count                      | Price | Share | Rate  | Reading  | Checked |
| ----- | -------------------------- | ----- | ----- | ----- | -------- | ------- |
| seven | 7                          | 19.99 | 1/7   | 20%   | 1.5      | true    |
| cent  | 100                        | 0.125 | 2/3   | 12.5% | 100      | false   |
| minus | -3                         | -4.5  | 5/2   | -5%   | -1.6e-19 | true    |
| huge  | 9_000_000_000_000_000_000  | 1000  | 3     | 0.5   | 6.02e23  | false   |

# What is done with the numbers above. A column with no type takes the type
# of its formula.
sheet Arithmetic

| Name  | Square | Inverse | Whole | Taxed | Split | Raised | Part | Scaled | Root | Likely |
| ----- | ------ | ------- | ----- | ----- | ----- | ------ | ---- | ------ | ---- | ------ |
| seven | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| cent  | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| minus | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |
| huge  | *      | *       | *     | *     | *     | *      | *    | *      | *    | *      |

# Exact stays exact as far as it fits: an Integer reaches 64 bits and a
# Decimal thirty-eight digits, and past that it is reported rather than
# wrapped. A division is held to the same thirty-eight digits.
Square  := Numbers[Count; *] ** 2
Inverse := 1 / Numbers[Count; *]
Whole   := Inverse * Numbers[Count; *]

# Sums, products and divisions of Decimals are Decimal, though a division
# need not end.
Taxed   := Numbers[Price; *] * 1.2
Split   := Numbers[Price; *] / 3

# Percents add up to a Percent. Anything else done with one gives the plain
# number, so a price times a rate is a price.
Raised  := Numbers[Rate; *] + 5%
Part    := Numbers[Price; *] * Numbers[Rate; *]

# One Float makes the result a Float.
Scaled  := Numbers[Share; *] * Numbers[Reading; *]
Root    := sqrt(Numbers[Reading; *].abs())

Likely  := Numbers[Checked; *] and Numbers[Share; *] < Half

# No exact number is a division by zero, so that is a Float: Inf, -Inf, or NaN
# for zero over zero. So is a function outside its domain. Each is written
# in a cell as it is shown, and the text of one is in quotes. A NaN is
# ordered greatest and equal to itself, as a dataframe orders it, so Same is
# true of one.
sheet Limits

| Top | Over | Root | Log | Limit | Same | Word   | Add           | Multiply      |
| --- | ---- | ---- | --- | ----- | ---- | ------ | ------------- | ------------- |
| 1   | *    | *    | *   | Inf   | *    | "Inf"  | =Inf+[*-6; *] | =Inf*[*-7; *] |
| -1  | *    | *    | *   | -Inf  | *    | "-Inf" | =Inf+[*-6; *] | =Inf/[*-7; *] |
| 0   | *    | *    | *   | NaN   | *    | "NaN"  | =Inf+[*-6; *] | =Inf*[*-7; *] |

Over := Top / 0
Root := sqrt(Top)
Log  := ln(Top)
Same := Limit == Limit

# The name of a type converts to it: `x.Integer`, `x.Integer()` or `Integer(x)`.
sheet Converted

| Value  | AsInt | Rounded | AsDecimal | AsPercent | AsNum | AsBool | AsText |
| ------ | ----- | ------- | --------- | --------- | ----- | ------ | ------ |
| 19.99  | *     | *       | *         | *         | *     | *      | *      |
| -19.99 | *     | *       | *         | *         | *     | *      | *      |
| 1/3    | *     | *       | *         | *         | *     | *      | *      |
| 1/8    | *     | *       | *         | *         | *     | *      | *      |
| 0.5    | *     | *       | *         | *         | *     | *      | *      |
| 0      | *     | *       | *         | *         | *     | *      | *      |

AsInt     := Value.Integer
Rounded   := round(Value)

# A Float always has a Decimal: the one it is shown as.
AsDecimal := Value.Float.Decimal
AsPercent := Value.Percent
AsNum     := Value.Float
AsBool    := Value.Boolean
AsText    := Value.String

# A Fraction column shows what it holds as a fraction, and anything worked
# out from one is a fraction too.
sheet Mixes

Yield : Fraction

| Name   | Yield | Doubled | Share |
| ------ | ----- | ------- | ----- |
| mortar | 7/3   | *       | *     |
| screed | 22/7  | *       | *     |
| lean   | 2 3/4 | *       | *     |
| wide   | 0.5   | *       | *     |

Doubled := Yield * 2
Share   := Yield.Percent

# String is read the way a cell is.
sheet Written

String : String

| String  | Number | Doubled | Whole | Decimal | Percent |
| ----- | ------ | ------- | ----- | ------- | ------- |
| 42    | *      | *       | *     | *       | *       |
| 20%   | *      | *       | *     | *       | *       |
| 1/8   | *      | *       | *     | *       | *       |
| 1.5e3 | *      | *       | *     | *       | *       |

Number  := String.Decimal
Doubled := Number * 2
Whole   := String.Integer
Decimal := String.Decimal
Percent := String.Percent

# A web address, an email address and a UUID are text read as something
# narrower: the cell keeps the text that was written, and the column says
# what it was read as. A column declared as one takes only text that reads
# as one, so a cell that is not an address says so where it is.
sheet Text

Site    : Url
Contact : Email
Ref     : Uuid

| Site                   | Contact               | Ref                                  | Written           | Checked | AsText |
| ---------------------- | --------------------- | ------------------------------------ | ----------------- | ------- | ------ |
| https://example.com    | name@example.com      | 7b4e2c10-5f8a-4c3e-9d21-0a1b2c3d4e5f | sales@example.com | *       | *      |
| mailto:help@example.uk | a.b+tag@example.co.uk | 00000000-0000-0000-0000-000000000000 | ops@example.co.uk | *       | *      |

# Text that came in from a file is read as one of them by the type's name,
# which is how a column of it is checked a row at a time.
Checked := Written.Email

# Any of them is text, and goes where text is asked for.
AsText  := Contact.String
