# A running balance: each row reads the row before it. A memo is text
# written bare, so it may hold Markdown; in quotes it would be as it is.

sheet Ledger

When : DateTime
Memo : Text

When                | Memo                                            | Amount | Balance | Average
2025-01-03T09:15    | **Opening** deposit                             | 2500   | *       | *
2025-01-09T08:00    | Rent, as the [lease](https://example.com/lease) | -1200  | *       | *
2025-01-15T18:42:07 | Groceries                                       | -86.40 | *       | *
2025-01-28T00:05    | Salary, _less tax_                              | 3100   | *       | *
2025-02-02T13:30    | Electricity, meter `E-4471`                     | -64.15 | *       | *

Balance := (Ledger[Balance; *-1] // 0) + Amount
Average := Ledger[Amount; 0..*].avg()
