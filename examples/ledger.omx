# A running balance: each row reads the row before it.

table Ledger

When : DateTime
Memo : Text

When                | Memo            | Amount
2025-01-03T09:15    | Opening deposit | 2500
2025-01-09T08:00    | Rent            | -1200
2025-01-15T18:42:07 | Groceries       | -86.40
2025-01-28T00:05    | Salary          | 3100
2025-02-02T13:30    | Electricity     | -64.15

Balance := (Ledger[Balance; *-1] // 0) + Amount
Average := Ledger[Amount; 0..*].avg()
