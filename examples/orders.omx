# Two tables: a lookup from one into the other, and conditional sums.

table Customers

ID | Name      | Region
1  | Ada Ltd   | UK
2  | Grace Inc | US
3  | Linus Oy  | FI

table Orders

CustomerID | Qty | Price
2          | 3   | 19.99
1          | 10  | 4.50
9          | 1   | 100
2          | 2   | 7.25

Customer := Customers[ID == CustomerID].Name // "Unknown"
Region   := Customers[ID == CustomerID].Region // "?"
Total    := Qty * Price
Discount := if Total > 50 and Region in ["UK", "US"] then Total * 10% else 0

table ByRegion

Region
UK
US
FI

Count := Orders[Region == ByRegion[*; Region]].count()
Sales := Orders[Region == ByRegion[*; Region]].Total.sum()
