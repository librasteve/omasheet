# Two tables: a lookup from one into the other, conditional sums, and a
# date-time cutoff.

table Customers

ID | Name      | Region
1  | Ada Ltd   | UK
2  | Grace Inc | US
3  | Linus Oy  | FI

table Orders

Placed : DateTime

Placed           | CustomerID | Qty | Price
2025-03-03T09:12 | 2          | 3   | 19.99
2025-03-03T16:40 | 1          | 10  | 4.50
2025-03-04T11:05 | 9          | 1   | 100
2025-03-05T08:30 | 2          | 2   | 7.25

Customer := Customers[; ID == CustomerID].Name // "Unknown"
Region   := Customers[; ID == CustomerID].Region // "?"
Total    := Qty * Price
Discount := if Total > 50 and Region in ["UK", "US"] then Total * 10% else 0
Rush     := Placed < 2025-03-04T00:00

table ByRegion

Region
UK
US
FI

Count := Orders[; Region == ByRegion[Region; *]].count()
Sales := Orders[; Region == ByRegion[Region; *]].Total.sum()
