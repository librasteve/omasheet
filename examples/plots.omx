| 13:00 | 17   |
| 14:00 | 18   |
| 15:00 | 21   |
| 16:00 | 30   |
| 17:00 | 38   |
| 18:00 | 40   |
| 19:00 | 32   |
| 20:00 | 26   |
| 21:00 | 20   |
| 22:00 | 16   |
| 23:00 | 13   |

// The price holds until the next row.
plot Day
type: step
data: Tariff
title: Electricity price by time of day
units: y

