sheet Spiral

| N  | Z   | Re | Im |
| -- | --- | -- | -- |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |
| *  | *   | *  | *  |

N := 0 ... 24

// A complex number is plotted by its parts, on the plane: the real part
// along and the imaginary part up. Each step turns the point by 0.3
// radian and shrinks its distance from the origin by about a tenth.
Z  := exp((-0.1 + 0.3i) * N)
Re := re(Z)
Im := im(Z)
