// More plots, after the examples of plotly.rs: the kinds that suit
// scientific data, and a few for business. Each is a `plot` declared like a
// sheet, drawn where the app or a report asks for it.
//
// A line, scatter or area plot is drawn at its `x` where those are numbers,
// and a scatter or bubble plot needs them.

sheet Oscillator

Time : Duration[s; .1f]
Amplitude : Length[mm]

| Time | Amplitude |
| ---- | --------- |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |
| *    | *         |

Time := 0.0s, 0.5s ... 12.0s
Amplitude := Length(exp(-Time / 4s) * cos(Time * 2Hz), 'mm')

plot Argand
type: line
data: Spiral
x: Re
y: Im
title: exp((-0.1 + 0.3i) n) on the complex plane
origin: both
ticks: both
legend: false

sheet Rates

// A price for each kWh in pence: a bare number is read as pence, and `$p`
// shows it so in each row, while formulas have it in pounds.
Cost : Quantity[GBP.kWh^-1; $p.1f]

| Supplier | Cost            |
| -------- | --------------- |
| Octopus  | 24.5            |
| British  | 27.2            |
| EDF      | 26.3            |
| Ovo      | 28.1            |
| Shell    | 25.9            |

plot UnitRate
type: bar
data: Rates
title: Electricity unit rate
units: both
labels: both

sheet Spend

Amount : Currency[GBP; $]

| Category  | Amount |
| --------- | ------ |
| Rent      | 1200   |
| Food      | 450    |
| Transport | 180    |
| Energy    | 130    |
| Leisure   | 240    |

// Each value as a share of the whole.
plot Share
type: pie
data: Spend
title: Where the month's money goes

sheet Gravity

G : Acceleration[m.s^-2]

| Lab        | G          |
| ---------- | ---------- |
| Teddington | 9.8123(21) |
| Paris      | 9.8091(34) |
| Potsdam    | 9.8139(18) |
| Boulder    | 9.8010(60) |
| Tokyo      | 9.7981(27) |

// A value with an uncertainty: a body of one standard deviation and a
// wick of two.
plot Labs
type: candle
data: Gravity
title: Local gravity g (m/s²) by lab

sheet Calibration

Current : Current[A]
Voltage : Potential[V]

| Current | Voltage   |
| ------- | --------- |
| 0.5     | 1.04(22)  |
| 1.0     | 2.33(25)  |
| 1.5     | 3.24(28)  |
| 2.0     | 4.32(30)  |
| 2.5     | 5.27(32)  |
| 3.0     | 6.55(35)  |
| 3.5     | 7.98(38)  |
| 4.0     | 8.91(40)  |
| 4.5     | 10.16(43) |
| 5.0     | 11.06(45) |

// Points with an error bar of one standard deviation for each value that
// has an uncertainty.
plot Ohm
type: scatter
data: Calibration
title: Voltage (V) against current (A)

// Logarithmic scales.
sheet Decay

| Minutes | Counts |
| ------- | ------ |
| 0       | 1000   |
| 10      | 500    |
| 20      | 252    |
| 30      | 124    |
| 40      | 63     |
| 50      | 31     |
| 60      | 16     |

// One axis: `logy` makes equal steps up the plot equal ratios, so a
// decay that halves each time is a straight line, and `fit` finds it.
plot HalfLife
type: scatter
data: Decay
x: Minutes
y: Counts
title: Counts left in a sample
logy: true
fit: true
ticks: both

sheet Periods

| Planet  | AU    | Years |
| ------- | ----- | ----- |
| Mercury | 0.387 | 0.241 |
| Venus   | 0.723 | 0.615 |
| Earth   | 1     | 1     |
| Mars    | 1.524 | 1.881 |
| Jupiter | 5.203 | 11.86 |
| Saturn  | 9.537 | 29.46 |

// Both axes: a power law is a straight line on log-log axes, and the
// slope of the fit is the power, here Kepler's 3/2.
plot Kepler
type: scatter
data: Periods
x: AU
y: Years
title: Orbital period against distance
logx: true
logy: true
fit: true
labels: y
ticks: both

sheet Rainfall

Rain : Length[mm]

| Month | Rain | Total |
| ----- | ---- | ----- |
| Jan   | 78   | *     |
| Feb   | 52   | *     |
| Mar   | 60   | *     |
| Apr   | 48   | *     |
| May   | 55   | *     |
| Jun   | 50   | *     |
| Jul   | 45   | *     |
| Aug   | 62   | *     |
| Sep   | 70   | *     |
| Oct   | 88   | *     |
| Nov   | 95   | *     |
| Dec   | 90   | *     |

Total := Rain.cum_sum()

// A line with the area under it filled.
plot Season
type: area
data: Rainfall
y: Total
title: Cumulative rainfall (mm) by month
units: y

sheet Energy

Year : Integer
Coal : Energy[TWh]
Gas : Energy[TWh]
Wind : Energy[TWh]
Solar : Energy[TWh]

| Year | Coal | Gas | Wind | Solar |
| ---- | ---- | --- | ---- | ----- |
| 2018 | 38   | 40  | 12   | 4     |
| 2019 | 33   | 41  | 14   | 5     |
