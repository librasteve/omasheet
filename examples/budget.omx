# A monthly budget: computed columns, a constant, and one-off formula cells.

const TaxRate = 20%

sheet Sales

Closed : Datetime
Margin : Percent
Growth : Percent

| Month | Closed           | Revenue                     | Cost | Profit | Tax | Margin | Growth |
| ----- | ---------------- | --------------------------- | ---- | ------ | --- | ------ | ------ |
| Jan   | 2025-02-03T17:30 | 10000                       | 6000 | *      | *   | *      | *      |
| Feb   | 2025-03-04T12:00 | 12000                       | 7000 | *      | *   | *      | *      |
| Mar   | 2025-04-02T09:45 | = Sales[Revenue; *-1] * 1.1 | 7500 | *      | *   | *      | *      |

Profit := Revenue - Cost
Tax    := Profit * TaxRate
Margin := Profit / Revenue
Growth := Revenue / Sales[Revenue; *-1] - 1

sheet Summary

| Item           | Value                                                   |
| -------------- | ------------------------------------------------------- |
| Revenue        | = Sales.Revenue.sum()                                   |
| Profit         | = Sales.Profit.sum()                                    |
| Best month     | = Sales[; Profit == Sales.Profit.max()].Month // "none" |
| Average margin | = Sales.Margin.mean()                                    |
| Books closed   | = Sales.Closed.max()                                    |

# What each month was meant to bring in. Feb was set twice, Apr has no
# sales yet, and Mar has no goal.

sheet Goals

| Month | Target | Owner |
| ----- | ------ | ----- |
| Jan   | 9500   | Ann   |
| Feb   | 11000  | Bob   |
| Feb   | 12500  | Cy    |
| Apr   | 14000  | Ann   |

# Each month's sales beside its goals: `join` pairs the rows of two
# sheets whose key columns are equal, a row for every pair, so Feb is there
# twice. `left` keeps a month that matches nothing, Mar with no goal, and
# a month with no sales does not appear.

sheet Against := Sales |> select(Month, Revenue, Profit) |> join(Goals, Month, left)
