| ^ ### France total |      |       |        | = [Q1_Web; block].sum() | = [Q1_Shop; block].sum() | = [Q1_Sum; block].sum()                  |        | = [Q2_Web; block].sum() | = [Q2_Shop; block].sum() | = [Q2_Sum; block].sum()                  | = [H1_Sum; block].sum()                 |       |        | = [Q3_Web; block].sum() | = [Q3_Shop; block].sum() | = [Q3_Sum; block].sum()                  |        | = [Q4_Web; block].sum() | = [Q4_Shop; block].sum() | = [Q4_Sum; block].sum()                  | = [H2_Sum; block].sum()                 | = [FY_Sum; block].sum()                 |
| ^ ## EMEA total    |      |       |        | = [Q1_Web; block].sum() | = [Q1_Shop; block].sum() | = [Q1_Sum; block].sum()                  |        | = [Q2_Web; block].sum() | = [Q2_Shop; block].sum() | = [Q2_Sum; block].sum()                  | = [H1_Sum; block].sum()                 |       |        | = [Q3_Web; block].sum() | = [Q3_Shop; block].sum() | = [Q3_Sum; block].sum()                  |        | = [Q4_Web; block].sum() | = [Q4_Shop; block].sum() | = [Q4_Sum; block].sum()                  | = [H2_Sum; block].sum()                 | = [FY_Sum; block].sum()                 |
