| Tokyo              |      |       |        | 30                      | 33                       | = Sales[Q1_Web; 13] + Sales[Q1_Shop; 13] |        | 42                      | 45                       | = Sales[Q2_Web; 13] + Sales[Q2_Shop; 13] | = Sales[Q1_Sum; 13] + Sales[Q2_Sum; 13] |       |        | 20                      | 23                       | = Sales[Q3_Web; 13] + Sales[Q3_Shop; 13] |        | 32                      | 35                       | = Sales[Q4_Web; 13] + Sales[Q4_Shop; 13] | = Sales[Q3_Sum; 13] + Sales[Q4_Sum; 13] | = Sales[H1_Sum; 13] + Sales[H2_Sum; 13] |
