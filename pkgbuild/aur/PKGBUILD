# Maintainer: Stephen Roe <stephen.john.roe@gmail.com>

# The recipe published to the AUR: it builds a release from its source
# archive. `.github/workflows/aur.yml` sets pkgver and the checksum and pushes
# it there on each release; `pkgbuild/PKGBUILD` builds the checkout instead.

pkgname=omasheet
pkgver=0.1.2
pkgrel=1
pkgdesc='Text-native spreadsheet: plain-text .omx files, with a Qt Quick app'
arch=('x86_64' 'aarch64')
url='https://github.com/librasteve/omasheet'
license=('MIT')
install='omasheet.install'
# The C++ of the Qt bridge is linked by rustc, which cannot read GCC's LTO.
options=('!debug' '!lto')
# The QML is compiled against the Qt it is built with, and does not start on
# an older one: so the package needs at least the Qt that is here when it is
# made. Before that Qt is installed, to build with, any will do.
_at_least() {
  local built
  built=$(pacman -Q "$1" 2>/dev/null | cut -d' ' -f2)
  if [[ -n $built ]]; then
    printf '%s>=%s' "$1" "${built%-*}"
  else
    printf '%s' "$1"
  fi
}
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  "$(_at_least qt6-base)"
  "$(_at_least qt6-declarative)"
  'xdg-desktop-portal'
)
makedepends=(
  'cargo'
  'gcc'
  'lld'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b05bf97aa2593624f8287cbc0d98315685b146df9a28aa9f823816c357aa5b75')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --package omasheet-ui
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omasheet "$pkgdir/usr/bin/omasheet"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omasheet.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasheet.svg"
  install -Dm644 pkgbuild/omasheet.desktop "$pkgdir/usr/share/applications/omasheet.desktop"
  install -Dm644 pkgbuild/omasheet.xml "$pkgdir/usr/share/mime/packages/omasheet.xml"
}
