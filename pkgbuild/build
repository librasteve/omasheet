#!/usr/bin/env bash
# Make the package in a clean container, where what it needs to build is
# exactly what the PKGBUILD names. Run as root in an Arch Linux or an Arch
# Linux ARM container, with the checkout mounted:
#
#   docker run --rm -v "$PWD:/src" archlinux:base-devel /src/pkgbuild/build
#
# The package is left in pkgbuild/.

set -euo pipefail

cd "$(dirname "$0")/.."

# A container has no kernel sandbox for pacman to use, and its file system is
# not one whose free space pacman can count.
sed -i -e '/^\[options\]/a DisableSandbox' -e 's/^CheckSpace/#CheckSpace/' /etc/pacman.conf

pacman-key --init
pacman-key --populate

# The Arch Linux ARM image is a whole system: leave its kernel behind.
for package in $(pacman -Qq | grep -E '^linux-(aarch64|firmware)' || true); do
  pacman -Rdd --noconfirm "$package" || true
done

pacman -Syu --noconfirm --needed base-devel

# makepkg does not run as root.
id builder >/dev/null 2>&1 || useradd -m builder
echo 'builder ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/builder
chown -R builder: .

su builder -c 'cd pkgbuild && PKGEXT=.pkg.tar.zst makepkg --syncdeps --noconfirm --force'
